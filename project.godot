; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PUNT"
run/main_scene="uid://dw32oaofjwhi6"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

LevelManager="*res://singletons/level_manager.gd"
MenuManager="*res://singletons/menu_manager.gd"
MultiplayerInput="*res://addons/multiplayer_input/multiplayer_input.gd"
PlayerManager="*res://singletons/player_manager.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[dotnet]

project/assembly_name="PUNT"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_3d_auto_collision_generator/plugin.cfg", "res://addons/multiplayer_input/plugin.cfg", "res://addons/physics_collision_import_generator/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[global_group]

level=""
menu=""

[gui]

timers/tooltip_delay_sec=0.2
timers/tooltip_delay_sec.editor_hint=0.2

